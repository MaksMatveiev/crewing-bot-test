# Скопируй этот файл в .env и впиши свои значения.

# Ключ Gemini: https://aistudio.google.com/apikey
GOOGLE_API_KEY=...

# База Supabase: Settings -> Database -> Connection string.
# Бери вариант Session pooler: прямое подключение (db.<ref>.supabase.co)
# работает только там, где есть IPv6 — ни на большинстве машин, ни на Render его нет.
DATABASE_URL=postgresql://postgres.<ref>:ПАРОЛЬ@aws-0-<регион>.pooler.supabase.com:5432/postgres

# Пароль вкладки рекрутера — придумай свой.
RECRUITER_PASSWORD=...

# ОТДЕЛЬНАЯ база для тестов: прогон делает TRUNCATE всех таблиц.
# Без этой переменной тесты базы пропускаются. Совпадать с DATABASE_URL нельзя.
TEST_DATABASE_URL=

# 📨 Telegram: карточка заявки кандидату. Необязательно — без этих
# переменных бот работает как обычно, ссылка просто не показывается.
# Бот заводится у @BotFather командой /newbot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Произвольная случайная строка: ею подписываются входящие запросы от Telegram.
TELEGRAM_WEBHOOK_SECRET=

# Модель Gemini. По умолчанию gemini-flash-lite-latest — у каждой модели
# своя суточная квота (20 запросов на бесплатном тарифе). Когда лимит
# основной свободен, gemini-3.6-flash отвечает заметно быстрее.
GEMINI_MODEL=

# Канал с вакансиями: адрес вида @moy_kanal (бот должен быть его
# администратором с правом публиковать сообщения).
TELEGRAM_CHANNEL=

# Адрес сайта — уходит ссылкой в объявление канала.
SITE_URL=https://crewing-ai.onrender.com

# Контакты агентства в объявлении канала. Телефоны — через точку с запятой.
AGENCY_EMAIL=
AGENCY_PHONES=

# Час ежедневной публикации вакансий и пояс, в котором его считать.
PUBLISH_HOUR=8
PUBLISH_TIMEZONE=Europe/Kyiv

# Валюта ставки в объявлении канала: USD, EURO и так далее.
SALARY_CURRENCY=USD
